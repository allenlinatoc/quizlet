{
  "name": "quizlet-local",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "src",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -k \"node --env-file-if-exists=.env ./node_modules/tsx/dist/cli.mjs watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.js",
    "start": "node --env-file-if-exists=.env dist-server/index.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "python tests/run_browser.py"
  },
  "dependencies": {
    "@tiptap/core": "^3.33.0",
    "@tiptap/extension-image": "^3.0.0",
    "@tiptap/react": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "adm-zip": "^0.5.16",
    "better-sqlite3": "^12.0.0",
    "exceljs": "4.4.0",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.0.0",
    "image-size": "^2.1.0",
    "jszip": "3.10.1",
    "katex": "^0.16.22",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.0",
    "openai": "^7.55.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yauzl": "3.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.0",
    "@types/katex": "^0.16.7",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/yauzl": "2.10.3",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
