# Copy this file to .env and fill in your OpenAI API details.

# Refer to `.agents/docs/openai-pdf-model-pricing.md` for reference.
#
#
# Example: OPENAI_API_KEY=sk-your-api-key
OPENAI_API_KEY=
# Example: OPENAI_PDF_MODEL=gpt-5
OPENAI_PDF_MODEL=
# Example prices below are illustrative, not current rates. Check your model's pricing.
# Example: OPENAI_PDF_INPUT_PRICE_PER_MILLION=1.25
OPENAI_PDF_INPUT_PRICE_PER_MILLION=
# Example: OPENAI_PDF_OUTPUT_PRICE_PER_MILLION=10.00
OPENAI_PDF_OUTPUT_PRICE_PER_MILLION=

# Optional separate text-extract-api service for PDF processing without OpenAI.
# Run the service and its OCR worker, Redis and Ollama separately; restart Quizlet after changes.
# TEXT_EXTRACT_API_URL=http://127.0.0.1:8000
# TEXT_EXTRACT_OCR_STRATEGY=easyocr
# TEXT_EXTRACT_LANGUAGE=en
# TEXT_EXTRACT_OLLAMA_MODEL=llama3.1
# TEXT_EXTRACT_POLL_INTERVAL_MS=2000
# TEXT_EXTRACT_TASK_TIMEOUT_MS=900000
# TEXT_EXTRACT_REQUEST_TIMEOUT_MS=120000

# Optional local server and data directory settings:
# PORT=3001
# QUIZLET_DATA_DIR=data
